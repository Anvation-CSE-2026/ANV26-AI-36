# Copy this file to ".env" (same folder) and fill ONE of the keys below. Then restart the backend.
# Without any key the assistant still answers in "offline mode" (shows matching text from your records, no AI).

# Option 1 - Google Gemini (has a free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# (Leave the model empty: CareLens picks a working Gemini model automatically. Google retires old model names, e.g. gemini-2.0-flash.)

# Option 2 - Anthropic Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Option 3 - OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: force a provider (anthropic | gemini | openai) and/or a model name
# CARELENS_PROVIDER=gemini
# CARELENS_MODEL=

# ---- Security settings (all optional) ----
# Encryption key for stored documents and the saved AI key. If empty, a random key is created in instance/data_key.
# Generate your own with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CARELENS_DATA_KEY=
# Minutes of inactivity before you are signed out (default 60, 0 = never).
# CARELENS_IDLE_MINUTES=60
# Only needed if you open the app from a name other than localhost / 127.0.0.1 (comma separated).
# CARELENS_ALLOWED_HOSTS=
# CARELENS_ALLOWED_ORIGINS=
# Set to 1 when the site is served over HTTPS so the session cookie is sent only over HTTPS.
# FAMILY_COOKIE_SECURE=1
# Remove phone numbers, emails, Aadhaar/PAN-style IDs and card numbers from text sent to the AI provider (default 1; 0 = send as is).
# CARELENS_REDACT=1
